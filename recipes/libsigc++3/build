#!/bin/sh -e
sed -i 's,library(,both_libraries(,' sigc++/meson.build
meson setup build \
    --prefix="$CHY_PREFIX" \
    --sysconfdir="$CHY_ROOT/etc" \
    --libdir=lib \
    --buildtype=release \
    -Dmaintainer-mode=false \
    -Dbuild-documentation=false \
    -Dbuild-examples=false \
    -Dbuild-pdf=false \
    -Dbenchmark=false \
    -Dwarnings=max
ninja -C build
DESTDIR="$1" ninja -C build install
